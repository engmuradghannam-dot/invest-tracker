# قاعدة البيانات
DATABASE_URL="postgresql://postgres:password@localhost:5432/invest_tracker?schema=public"

PORT=4000

# مجلد الإيصالات المرفوعة
UPLOAD_DIR=./uploads
# كم دورة تُولَّد للمشاريع مفتوحة المدة
OPEN_ENDED_CYCLES=24

# التنبيهات بالبريد — اتركها فارغة لتعطيل المجدول
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=app-password-here
SMTP_FROM=your@gmail.com

# لمن تُرسل التنبيهات
REMINDER_TO=your@gmail.com
# كم يوماً قبل الاستحقاق
REMINDER_DAYS_BEFORE=3
